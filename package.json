{
  "name": "quota-glass",
  "version": "0.4.3",
  "private": true,
  "description": "Local Codex usage companion",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --win portable --x64",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:installer": "npm run build && electron-builder --win nsis --x64 --config.directories.output=release/installer"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "local.quota.glass",
    "productName": "Quota Glass",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/QuotaGlass.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "portable": {
      "artifactName": "QuotaGlass-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "QuotaGlass-Setup-${version}-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerLanguages": ["zh_CN", "en_US"],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quota Glass",
      "uninstallDisplayName": "Quota Glass",
      "installerIcon": "assets/QuotaGlass.ico",
      "uninstallerIcon": "assets/QuotaGlass.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "differentialPackage": false
    }
  }
}
